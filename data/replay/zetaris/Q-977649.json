 "sql": "SELECT p.labeler_name, ps.est_duns, st.fei, st.firm_name FROM fda.shortage_presentations sp JOIN lightning.metastore.upstream.upstream_usl.product p ON p.package_ndc = sp.package_ndc JOIN lightning.metastore.upstream.upstream_usl.product_site ps ON ps.set_id = p.spl_set_id LEFT JOIN lightning.metastore.upstream.upstream_usl.site st ON st.duns = ps.est_duns WHERE sp.generic = 'Methylphenidate Film, Extended Release'",
